+static unsigned long long checks,failures;
+static void cases(void)
+{
+    struct aupe_crypto_binding b = {0}, other = {0};
+    af_u8 pub[32]={3}, wrong[32]={4}, zero[32]={0};
+    int ids[4]={0};
